<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:x="urn:schemas-microsoft-com:office:excel"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="utf-8">
<!--[if gte mso 9]>
<xml>
 <x:ExcelWorkbook>
  <x:ExcelWorksheets>
   <x:ExcelWorksheet>
    <x:Name>Master Comparison</x:Name>
    <x:WorksheetOptions>
     <x:DisplayGridlines/>
    </x:WorksheetOptions>
   </x:ExcelWorksheet>
  </x:ExcelWorksheets>
 </x:ExcelWorkbook>
</xml>
<![endif]-->
<style>
  body { font-family: Calibri, sans-serif; }
  table { border-collapse: collapse; }
  th { background-color: #0d47a1; color: #ffffff; font-weight: bold; border: 1px solid #90caf9; padding: 10px; text-align: center; font-size: 11pt; }
  td { border: 1px solid #cfd8dc; padding: 8px 12px; font-size: 10.5pt; }
  .title-cell { font-size: 16pt; font-weight: bold; color: #0d47a1; background-color: #e3f2fd; padding: 15px; border: none; }
  .section-cell { font-size: 12pt; font-weight: bold; color: #1565c0; background-color: #f5f5f5; border: 1px solid #b0bec5; }
  .highlight-tbd { background-color: #e8f5e9; font-weight: bold; color: #2e7d32; text-align: center; }
  .metric-label { font-weight: 600; color: #263238; }
  .num-val { text-align: center; }
  .formula-note { font-size: 9pt; color: #546e7a; font-style: italic; }
</style>
</head>
<body>

<table>
  <tr>
    <td colspan="5" class="title-cell">INTELLIGENT GIT WORKFLOW OPTIMIZATION: EMPIRICAL PERFORMANCE METRICS</td>
  </tr>
  <tr>
    <td colspan="5" style="border:none; padding: 5px; font-size: 10pt; color: #546e7a;">
      Project: Git Branching Strategy Optimization (Git Flow vs GitHub Flow vs Trunk-Based Development)
    </td>
  </tr>
  <tr><td colspan="5" style="border:none;"></td></tr>

  <!-- MASTER COMPARISON TABLE -->
  <tr>
    <th>Metric Parameter</th>
    <th>Evaluation Formula</th>
    <th>Git Flow</th>
    <th>GitHub Flow</th>
    <th>Trunk-Based Development</th>
  </tr>

  <tr>
    <td class="metric-label">Total Pull Requests Evaluated</td>
    <td class="formula-note">Count of feature, release, hotfix PRs</td>
    <td class="num-val">8</td>
    <td class="num-val">6</td>
    <td class="highlight-tbd">10</td>
  </tr>

  <tr>
    <td class="metric-label">PRs with Merge Conflicts</td>
    <td class="formula-note">PRs requiring manual 3-way resolution</td>
    <td class="num-val">3</td>
    <td class="num-val">1</td>
    <td class="highlight-tbd">0</td>
  </tr>

  <tr style="background-color: #fff9c4;">
    <td class="metric-label"><strong>Merge Conflict Rate (%)</strong></td>
    <td class="formula-note">=(PRs with Conflicts / Total PRs)*100</td>
    <td class="num-val" style="color: #c62828; font-weight: bold;">37.5%</td>
    <td class="num-val" style="color: #e65100; font-weight: bold;">16.7%</td>
    <td class="highlight-tbd" style="font-size: 11pt;">0.0%</td>
  </tr>

  <tr style="background-color: #e0f2f1;">
    <td class="metric-label"><strong>Average Integration Time (hours)</strong></td>
    <td class="formula-note">=&Sigma;(T_merge - T_first_commit) / Total PRs</td>
    <td class="num-val" style="color: #c62828; font-weight: bold;">34.2 hrs</td>
    <td class="num-val" style="font-weight: bold;">6.8 hrs</td>
    <td class="highlight-tbd" style="font-size: 11pt;">1.9 hrs</td>
  </tr>

  <tr>
    <td class="metric-label"><strong>Commit Frequency (commits/dev/day)</strong></td>
    <td class="formula-note">=Non-merge commits / (Devs &times; Days)</td>
    <td class="num-val">2.1</td>
    <td class="num-val">4.5</td>
    <td class="highlight-tbd">8.4</td>
  </tr>

  <tr>
    <td class="metric-label">Median Review Turnaround Time</td>
    <td class="formula-note">Median(Reviewer assignment to approval)</td>
    <td class="num-val">14.5 hrs</td>
    <td class="num-val">3.2 hrs</td>
    <td class="highlight-tbd">0.8 hrs</td>
  </tr>

  <tr>
    <td class="metric-label">Average Review Rounds per PR</td>
    <td class="formula-note">Review iterations before merge</td>
    <td class="num-val">2.4 rounds</td>
    <td class="num-val">1.2 rounds</td>
    <td class="highlight-tbd">1.1 rounds</td>
  </tr>

  <tr>
    <td class="metric-label">PRs Merged within 24 Hours</td>
    <td class="formula-note">=(PRs &lt; 24h / Total PRs)*100</td>
    <td class="num-val">25.0%</td>
    <td class="num-val">83.3%</td>
    <td class="highlight-tbd">100.0%</td>
  </tr>

  <tr style="background-color: #fbe9e7;">
    <td class="metric-label"><strong>Deployment Failure Rate (%)</strong></td>
    <td class="formula-note">=(Failed Staging Deploys / Total Deploys)*100</td>
    <td class="num-val" style="color: #c62828; font-weight: bold;">25.0%</td>
    <td class="num-val">12.5%</td>
    <td class="highlight-tbd" style="font-size: 11pt;">0.0%</td>
  </tr>

  <tr><td colspan="5" style="border:none; height: 20px;"></td></tr>

  <!-- SCENARIO DETAILED BREAKDOWN -->
  <tr>
    <td colspan="5" class="section-cell">SCENARIO BREAKDOWN &amp; COLLABORATION LOGS</td>
  </tr>

  <tr>
    <th>Scenario ID</th>
    <th>Description</th>
    <th>Git Flow Observation</th>
    <th>GitHub Flow Observation</th>
    <th>Trunk-Based Observation</th>
  </tr>

  <tr>
    <td class="num-val"><strong>Scenario 1</strong></td>
    <td>Decoupled Feature: Task API (Dev A) vs Task List UI (Dev B)</td>
    <td>Both branches isolated; merged to develop smoothly. Time: 18h.</td>
    <td>Merged into main via PRs after CI check. Time: 4.5h.</td>
    <td>Micro-PRs integrated quickly into main. Time: 1.2h.</td>
  </tr>

  <tr>
    <td class="num-val"><strong>Scenario 2</strong></td>
    <td>High-Collision: Search in TaskList (Dev A) vs Sorting in TaskList (Dev B)</td>
    <td>Severe merge conflict on lines 11-13 of TaskList.jsx. Required manual 3-way resolution.</td>
    <td>Merge conflict on Dev B's PR; resolved via GitHub PR web editor / rebase.</td>
    <td>Frequent rebasing against main avoided conflict. Zero conflict downtime.</td>
  </tr>

  <tr>
    <td class="num-val"><strong>Scenario 3</strong></td>
    <td>Quality &amp; Defect Fix: Input Validation (Dev A) vs Bug Fix (Dev B)</td>
    <td>Back-merged into develop and release branch. High ceremony.</td>
    <td>Direct feature branches; automated CI caught test regression.</td>
    <td>Integrated atomically with immediate CI verification on trunk.</td>
  </tr>

  <tr>
    <td class="num-val"><strong>Scenario 4</strong></td>
    <td>Release &amp; Staging Deploy: Docker compose staging health probe</td>
    <td>Batch release 1.0.0 had configuration mismatch on port 5000. 1 failure.</td>
    <td>Single deploy failed health check; fixed and rolled forward quickly.</td>
    <td>Incomplete features protected behind ENABLE_TASK_EXPORT flag. 0 failures.</td>
  </tr>

</table>

</body>
</html>

